// CEF Frameworks are managed by the CEFWebView package in the Frameworks directory
// Configure framework discovery, linking, and runtime resolution
SYSTEM_HEADER_SEARCH_PATHS = "$(SRCROOT)/../Frameworks"
FRAMEWORK_SEARCH_PATHS = "$(SRCROOT)/../Frameworks"
LIBRARY_SEARCH_PATHS = "$(SRCROOT)/../Frameworks"

// Runtime framework resolution paths
// Search in the app bundle's Frameworks folder first, then fall back to package Frameworks
LD_RUNPATH_SEARCH_PATHS = "@executable_path/../Frameworks $(SRCROOT)/../Frameworks"

// Copy frameworks to app bundle during build
// The Chromium Embedded Framework is copied via a Copy Files build phase
COPY_PHASE_STRIP = NO

SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// allow running scripts from Build Phase scripts
ENABLE_USER_SCRIPT_SANDBOXING = NO

CODE_SIGN_ENTITLEMENTS = WebView/WebView.entitlements
